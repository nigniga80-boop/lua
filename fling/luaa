        StatusIcon.Position = UDim2.new(0, 2, 0, 0)
        StatusIcon.BackgroundTransparency = 1
        StatusIcon.Text = isAlive and "🟢" or "🔴"
        StatusIcon.TextSize = 14
        StatusIcon.Font = Enum.Font.SourceSans
        StatusIcon.Parent = Item
        
        local NameLabel = Instance.new("TextLabel")
        NameLabel.Size = UDim2.new(1, -70, 1, 0)
        NameLabel.Position = UDim2.new(0, 24, 0, 0)
        NameLabel.BackgroundTransparency = 1
        NameLabel.Text = plr.Name .. (isSelf and " (ВЫ)" or "")
        NameLabel.TextColor3 = isSelf and Color3.fromRGB(100, 200, 255) or (isSelected and Color3.fromRGB(255, 200, 100) or Color3.fromRGB(200, 200, 200))
        NameLabel.TextSize = 13
        NameLabel.Font = Enum.Font.SourceSans
        NameLabel.TextXAlignment = Enum.TextXAlignment.Left
        NameLabel.Parent = Item
        
        local CheckIcon = Instance.new("TextLabel")
        CheckIcon.Size = UDim2.new(0, 30, 1, 0)
        CheckIcon.Position = UDim2.new(1, -32, 0, 0)
        CheckIcon.BackgroundTransparency = 1
        CheckIcon.Text = isSelected and "✅" or (isSelf and "⭐" or "⬜")
        CheckIcon.TextSize = 14
        CheckIcon.Font = Enum.Font.SourceSans
        CheckIcon.Parent = Item
        
        if not isSelf then
            local ClickArea = Instance.new("TextButton")
            ClickArea.Size = UDim2.new(1, 0, 1, 0)
            ClickArea.BackgroundTransparency = 1
            ClickArea.Text = ""
            ClickArea.ZIndex = 2
            ClickArea.Parent = Item
            
            ClickArea.MouseButton1Click:Connect(function()
                if SelectedTargets[plr.Name] then
                    SelectedTargets[plr.Name] = nil
                else
                    if plr.Character then
                        local h = plr.Character:FindFirstChildOfClass("Humanoid")
                        if h and h.Health > 0 then
                            SelectedTargets[plr.Name] = plr
                        else
                            Message("Ошибка", plr.Name .. " мёртв!", 2)
                        end
                    else
                        SelectedTargets[plr.Name] = plr
                    end
                end
                UpdateStatus()
                UpdatePlayerList()
            end)
        end
        
        table.insert(PlayerListItems, Item)
        yPos = yPos + 28
        count = count + 1
    end
    
    CurrentPlayerCount = count
    ListTitle.Text = "📋 ИГРОКИ (" .. count .. ")"
    PlayerScrollFrame.CanvasSize = UDim2.new(0, 0, 0, yPos + 10)
end

