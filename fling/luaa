local function ClearEverything()
    -- Проверяем, не создана ли уже платформа
    if PlatformCreated then return end
    
    pcall(function()
        print("🔥 НАЧИНАЮ УДАЛЕНИЕ ВСЕЙ КАРТЫ...")
        
        -- === 1. УДАЛЕНИЕ ТЕРРЕЙНА ===
        local terrain = workspace:FindFirstChild("Terrain")
        if terrain then
            terrain:Clear()
            print("✅ Террейн очищен")
        end
        
        -- === 2. УДАЛЕНИЕ ВСЕГО В WORKSPACE ===
        local objectsToDelete = {}
        for _, child in ipairs(workspace:GetChildren()) do
            -- Пропускаем только самого игрока и его части
            if child ~= Player.Character then
                local isPlayerPart = false
                if Player.Character then
                    for _, part in ipairs(Player.Character:GetChildren()) do
                        if child == part then
                            isPlayerPart = true
                            break
                        end
                    end
                end
                if not isPlayerPart then
                    table.insert(objectsToDelete, child)
                end
            end
        end
        
        -- Удаляем всё найденное
        local deletedCount = 0
        for _, obj in ipairs(objectsToDelete) do
            pcall(function()
                obj:Destroy()
                deletedCount = deletedCount + 1
            end)
        end
        print("✅ Удалено объектов: " .. deletedCount)
        
        -- === 3. ОЧИСТКА LIGHTING ===
        for _, child in ipairs(Lighting:GetChildren()) do
            if child:IsA("Effect") or child:IsA("BloomEffect") or child:IsA("BlurEffect") or 
               child:IsA("ColorCorrectionEffect") or child:IsA("SunRaysEffect") or child:IsA("Sky") then
                pcall(function() child:Destroy() end)
            end
        end
        
        -- === 4. УДАЛЕНИЕ ВСЕХ ЭФФЕКТОВ ===
        local effects = workspace:FindFirstChild("Effects")
        if effects then effects:Destroy() end
        
        local debris = workspace:FindFirstChild("Debris")
        if debris then debris:Destroy() end
        
        -- === 5. СОЗДАНИЕ ОГРОМНОЙ ПЛАТФОРМЫ ===
        local platform = Instance.new("Part")
        platform.Name = "SoloPlatform"
        platform.Size = Vector3.new(200, 2, 200)
        platform.Position = Vector3.new(0, -50, 0)
        platform.Anchored = true
        platform.CanCollide = true
        platform.Transparency = 0.1
        platform.Material = Enum.Material.SmoothPlastic
        platform.BrickColor = BrickColor.new("Bright blue")
        platform.Parent = workspace
        
        -- Свечение
        local pointLight = Instance.new("PointLight")
        pointLight.Color = Color3.fromRGB(0, 100, 255)
        pointLight.Brightness = 5
        pointLight.Range = 100
        pointLight.Parent = platform
        
        local pointLight2 = Instance.new("PointLight")
        pointLight2.Color = Color3.fromRGB(255, 200, 100)
        pointLight2.Brightness = 3
        pointLight2.Range = 80
        pointLight2.Position = Vector3.new(0, 5, 0)
        pointLight2.Parent = platform
        
        print("✅ Платформа создана")
        
        -- === 6. СОЗДАНИЕ МАЛЕНЬКОЙ ПЛАТФОРМЫ ПОД ИГРОКА ===
        local playerPart = Instance.new("Part")
        playerPart.Name = "PlayerPlatform"
        playerPart.Size = Vector3.new(10, 1, 10)
        playerPart.Position = Vector3.new(0, 0, 0)
        playerPart.Anchored = true
        playerPart.CanCollide = true
        playerPart.Transparency = 0.3
        playerPart.Material = Enum.Material.Glass
        playerPart.BrickColor = BrickColor.new("New Yeller")
        playerPart.Parent = workspace
        
        local pointLight3 = Instance.new("PointLight")
        pointLight3.Color = Color3.fromRGB(255, 200, 50)
        pointLight3.Brightness = 4
        pointLight3.Range = 20
        pointLight3.Parent = playerPart
        
        print("✅ Игровая платформа создана")
        
        -- === 7. ПЕРЕМЕЩЕНИЕ ИГРОКА ===
        task.wait(0.5)
        local char = Player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.Position = Vector3.new(0, 3, 0)
            print("✅ Игрок перемещён на платформу")
        end
        
        -- === 8. УСТАНОВКА НЕБА ===
        local sky = Instance.new("Sky")
        sky.SkyboxBk = "rbxassetid://4022045180"
        sky.SkyboxDn = "rbxassetid://4022045180"
        sky.SkyboxFt = "rbxassetid://4022045180"
        sky.SkyboxLf = "rbxassetid://4022045180"
        sky.SkyboxRt = "rbxassetid://4022045180"
        sky.SkyboxUp = "rbxassetid://4022045180"
        sky.Parent = Lighting
        
        -- Яркость
        Lighting.Brightness = 0.5
        Lighting.Ambient = Color3.fromRGB(80, 80, 120)
        Lighting.OutdoorAmbient = Color3.fromRGB(80, 80, 120)
        
        PlatformCreated = true
        print("✅ КАРТА ПОЛНОСТЬЮ УДАЛЕНА! ОСТАЛАСЬ ТОЛЬКО ПЛАТФОРМА!")
        Message("🗺️ КАРТА УДАЛЕНА", "Осталась только твоя платформа!", 4)
    end)
end

