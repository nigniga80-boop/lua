--[[
    🔥 АВТО-ФЛИНГ (ПОЛНАЯ ВЕРСИЯ)
    - Автоматически выбирает всех игроков
    - Автоматически запускает флинг
    - Переход на другой сервер каждые 10 минут
    - Восстанавливается после смерти
    - Сохраняется после перехода
]]

-- ========== СЛУЖБЫ ==========
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local Player = Players.LocalPlayer

-- ========== ДАННЫЕ ==========
if not getgenv().FlingData then
    getgenv().FlingData = {
        Active = false,
        Targets = {},
        RejoinCount = 0,
        AutoRejoin = true
    }
end

local FlingActive = getgenv().FlingData.Active or false
local SelectedTargets = {}
local RejoinTimer = nil
local RejoinCount = getgenv().FlingData.RejoinCount or 0
local AutoRejoinActive = getgenv().FlingData.AutoRejoin
local GuiCreated = false

getgenv().OldPos = nil
getgenv().FPDH = workspace.FallenPartsDestroyHeight

-- Восстанавливаем цели
for _, name in ipairs(getgenv().FlingData.Targets or {}) do
    local plr = Players:FindFirstChild(name)
    if plr and plr ~= Player then
        SelectedTargets[name] = plr
    end
end

-- ========== СОХРАНЕНИЕ ==========
local function SaveState()
    local targetNames = {}
    for name in pairs(SelectedTargets) do
        table.insert(targetNames, name)
    end
    getgenv().FlingData.Targets = targetNames
    getgenv().FlingData.Active = FlingActive
    getgenv().FlingData.RejoinCount = RejoinCount
    getgenv().FlingData.AutoRejoin = AutoRejoinActive
end

-- ========== ПЕРЕХОД НА ДРУГОЙ СЕРВЕР ==========
local function JoinOtherServer()
    if getgenv().IsJoining then return end
    getgenv().IsJoining = true

    print("[Скрипт] Переход на другой сервер...")

    if FlingActive then
        FlingActive = false
    end
    SaveState()

    -- Пытаемся найти другой сервер
    local servers = {}
    local success, result = pcall(function()
        return HttpService:GetAsync("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?limit=10")
    end)

    if success and result then
        local data = HttpService:JSONDecode(result)
        if data and data.data then
            for _, server in ipairs(data.data) do
                if server.id ~= game.JobId and server.playing < server.maxPlayers then
                    table.insert(servers, server.id)
                end
            end
        end
    end

    if #servers > 0 then
        local serverId = servers[math.random(1, #servers)]
        print("[Скрипт] Найден сервер: " .. serverId)
        TeleportService:TeleportToPlaceInstance(game.PlaceId, serverId, Player)
    else
        print("[Скрипт] Серверов не найдено, перезаход...")
        TeleportService:Teleport(game.PlaceId, Player)
    end

    wait(5)
    getgenv().IsJoining = false
end

