        UpdatePlayerList()
        UpdateStatus()
    end)

    Players.PlayerRemoving:Connect(function(player)
        if SelectedTargets[player.Name] then
            SelectedTargets[player.Name] = nil
            SaveState()
        end
        wait(1)
        UpdatePlayerList()
        UpdateStatus()
    end)

    -- ========== АВТОЗАПУСК ==========
    spawn(function()
        wait(3)

        UpdateStatus()
        UpdatePlayerList()
        UpdateCharStatus(true)

        local count = 0
        for _ in pairs(SelectedTargets) do count = count + 1 end
        if count == 0 then
            SelectAllPlayers()
        end

        if getgenv().FlingData.Active and not FlingActive then
            wait(1)
            StartFling()
        end

        if AutoRejoinActive then
            StartRejoinTimer()
        end

        Message("🔥 АВТО-УБИЙСТВО", "Скрипт активен! Убиваю всех!", 3)
        print("[Скрипт] Автозапуск завершён!")
    end)

    print("🔥 АВТО-ФЛИНГ ЗАГРУЖЕН!")
end

