SelectAllBtn.MouseButton1Click:Connect(SelectAllPlayers)
DeselectAllBtn.MouseButton1Click:Connect(DeselectAllPlayers)

AutoRejoinBtn.MouseButton1Click:Connect(function()
    AutoRejoinActive = not AutoRejoinActive
    AutoRejoinBtn.Text = AutoRejoinActive and "🔄 АВТО: ВКЛ" or "🔄 АВТО: ВЫКЛ"
    AutoRejoinBtn.BackgroundColor3 = AutoRejoinActive and Color3.fromRGB(0, 100, 0) or Color3.fromRGB(100, 0, 0)
    if AutoRejoinActive then
        StartRejoinTimer()
        Message("Авторежойн", "Включён (каждые 10 минут)", 2)
    else
        if RejoinTimer then
            RejoinTimer:Disconnect()
            RejoinTimer = nil
        end
        Message("Авторежойн", "Выключен", 2)
    end
end)

CloseButton.MouseButton1Click:Connect(function()
    StopFling()
    if RejoinTimer then RejoinTimer:Disconnect() end
    ScreenGui:Destroy()
end)

Players.PlayerAdded:Connect(function()
    wait(1)
    UpdatePlayerList()
    UpdateStatus()
end)

Players.PlayerRemoving:Connect(function(player)
    if SelectedTargets[player.Name] then
        SelectedTargets[player.Name] = nil
    end
    wait(1)
    UpdatePlayerList()
    UpdateStatus()
end)

Player.CharacterAdded:Connect(function(character)
    print("[Скрипт] Персонаж переродился!")
    local humanoid = character:WaitForChild("Humanoid")
    UpdateCharStatus(true)
    wait(2)
    RestoreAfterRespawn()
    
    humanoid.Died:Connect(function()
        print("[Скрипт] Персонаж умер!")
        UpdateCharStatus(false)
        if FlingActive then
            FlingActive = false
        end
    end)
end)

if Player.Character then
    local humanoid = Player.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        UpdateCharStatus(true)
        humanoid.Died:Connect(function()
            print("[Скрипт] Персонаж умер!")
            UpdateCharStatus(false)
            if FlingActive then
                FlingActive = false
            end
        end)
    end
end

-- ========== ЗАПУСК ==========

spawn(function()
    wait(3)
    UpdatePlayerList()
    
    local char = Player.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    
    if char and humanoid and humanoid.Health > 0 then
        UpdateCharStatus(true)
        SelectAllPlayers()
        wait(1)
        StartFling()
        StartRejoinTimer()
        Message("🔥 АВТО-УБИЙСТВО", "Скрипт активен!", 5)
    else
        Message("⏳ Ожидание", "Жду появления персонажа...", 3)
        local character = Player.CharacterAdded:Wait()
        character:WaitForChild("Humanoid")
        wait(2)
        UpdateCharStatus(true)
        SelectAllPlayers()
        wait(1)
        StartFling()
        StartRejoinTimer()
        Message("🔥 АВТО-УБИЙСТВО", "Скрипт активен!", 5)
    end
end)

print("🔥 АВТО-ФЛИНГ АКТИВИРОВАН! ВСЕ ФУНКЦИИ ЗАГРУЖЕНЫ!")
