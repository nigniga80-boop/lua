-- ============================================
-- 🌀 ФЛИНГ
-- ============================================
local function SkidFling(TargetPlayer)
    local Character = Player.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Humanoid and Humanoid.RootPart
    
    if not Character or not Humanoid or not RootPart or Humanoid.Health <= 0 then
        return false
    end
    
    local TCharacter = TargetPlayer.Character
    if not TCharacter then return false end
    
    local TRootPart = TCharacter:FindFirstChild("HumanoidRootPart")
    if not TRootPart then return false end
    
    workspace.FallenPartsDestroyHeight = 0/0
    
    local BV = Instance.new("BodyVelocity")
    BV.Parent = RootPart
    BV.Velocity = Vector3.new(0, 0, 0)
    BV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    
    Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
    
    local Angle = 0
    for i = 1, 10 do
        if not RootPart or not TRootPart then break end
        Angle = Angle + 100
        
        RootPart.CFrame = CFrame.new(TRootPart.Position) * CFrame.new(0, 1.5, 0) * CFrame.Angles(math.rad(Angle), 0, 0)
        Character:SetPrimaryPartCFrame(CFrame.new(TRootPart.Position) * CFrame.new(0, 1.5, 0) * CFrame.Angles(math.rad(Angle), 0, 0))
        RootPart.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
        RootPart.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
        task.wait()
        
        RootPart.CFrame = CFrame.new(TRootPart.Position) * CFrame.new(0, -1.5, 0) * CFrame.Angles(math.rad(Angle), 0, 0)
        Character:SetPrimaryPartCFrame(CFrame.new(TRootPart.Position) * CFrame.new(0, -1.5, 0) * CFrame.Angles(math.rad(Angle), 0, 0))
        RootPart.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
        RootPart.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
        task.wait()
    end
    
    BV:Destroy()
    Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
    workspace.FallenPartsDestroyHeight = getgenv().FPDH or -500
    
    return true
end

-- ============================================
-- 🎮 УПРАВЛЕНИЕ
-- ============================================
function StartFling()
    if FlingActive then return end
    
    local count = 0
    for _ in pairs(SelectedTargets) do count = count + 1 end
    if count == 0 then
        print("[Скрипт] Нет целей!")
        SelectAllPlayers()
        wait(1)
        count = 0
        for _ in pairs(SelectedTargets) do count = count + 1 end
        if count == 0 then
            print("[Скрипт] Всё равно нет целей!")
            return
        end
    end
    
    FlingActive = true
    getgenv().FlingData.Active = true
    SaveState()
    print("[Скрипт] Флинг запущен! Целей: " .. count)
    
    spawn(function()
        while FlingActive do
            local Character = Player.Character
            local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
            
            if not Character or not Humanoid or Humanoid.Health <= 0 then
                wait(2)
                continue
            end
            
            local validTargets = {}
            for name, player in pairs(SelectedTargets) do
                if player and player.Parent and player.Character then
                    local targetHumanoid = player.Character:FindFirstChildOfClass("Humanoid")
                    if targetHumanoid and targetHumanoid.Health > 0 then
                        validTargets[name] = player
                    end
                end
            end
            
            for _, player in pairs(validTargets) do
                if not FlingActive then break end
                SkidFling(player)
                wait(0.1)
            end
            
            wait(0.5)
        end
    end)
end

function StopFling()
    FlingActive = false
    getgenv().FlingData.Active = false
    SaveState()
    print("[Скрипт] Флинг остановлен")
end

-- ============================================
-- 📋 ВЫБОР ИГРОКОВ
-- ============================================
function SelectAllPlayers()
    SelectedTargets = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Player then
            SelectedTargets[plr.Name] = plr
        end
    end
    SaveState()
    print("[Скрипт] Выбрано игроков: " .. #Players:GetPlayers() - 1)
end

-- ============================================
-- ⏱️ ТАЙМЕР
-- ============================================
local function StartTimer()
    if RejoinTimer then RejoinTimer:Disconnect() end
    
    local timeLeft = 600
    print("[Скрипт] Таймер запущен! Переход через 10 минут")
    
    RejoinTimer = RunService.Heartbeat:Connect(function(dt)
        timeLeft = timeLeft - dt
        if timeLeft <= 0 then
            JoinOtherServer()
            RejoinTimer:Disconnect()
        end
    end)
end

