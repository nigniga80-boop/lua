local queueteleport = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport) or (Krnl and Krnl.queue_on_teleport)

if queueteleport then
    game.Players.LocalPlayer.OnTeleport:Connect(function()
        print("[Скрипт] Обнаружен переход, ставлю в очередь...")
        -- Сбрасываем флаг запуска
        getgenv().FlingRunning = false
        -- Ставим в очередь на выполнение после перехода
        queueteleport([[
            loadstring(game:HttpGet('https://raw.githubusercontent.com/nigniga80-boop/lua/main/fling/lua'))()
        ]])
    end)
    print("[✅] Авто-перезапуск после перехода включён!")
end

