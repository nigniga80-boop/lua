-- 💬 СООБЩЕНИЯ
-- ============================================
local function Message(Title, Text, Time)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = Title,
            Text = Text,
            Duration = Time or 3
        })
    end)
end

-- ============================================
-- 🔄 ПЕРЕЗАПУСК ПОСЛЕ ПЕРЕХОДА
-- ============================================
local function SetupAutoRejoin()
    -- Способ 1: queue_on_teleport (для Krnl, Synapse, Fluxus)
    local queueteleport = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport) or (Krnl and Krnl.queue_on_teleport)
    
    if queueteleport then
        game.Players.LocalPlayer.OnTeleport:Connect(function()
            print("[Скрипт] Обнаружен переход, ставлю в очередь...")
            getgenv().FlingData.ScriptRunning = false
            queueteleport([[
                loadstring(game:HttpGet('https://raw.githubusercontent.com/nigniga80-boop/lua/main/fling/lua'))()
            ]])
        end)
        print("[✅] queue_on_teleport подключён!")
        return true
    end
    
    -- Способ 2: для Xeno через Auto-Execute (пользователь должен настроить сам)
    print("[⚠️] queue_on_teleport НЕ поддерживается!")
    print("[💡] Для Xeno: добавь эту ссылку в Auto-Execute:")
    print("https://raw.githubusercontent.com/nigniga80-boop/lua/main/fling/lua")
    
    return false
end

-- ============================================
-- 🚀 АВТОЗАПУСК
-- ============================================
local function AutoStart()
    print("[Скрипт] Инициализация...")
    
    -- Ждём персонажа
    local char = Player.Character
    if not char then
        char = Player.CharacterAdded:Wait()
    end
    char:WaitForChild("Humanoid")
    
    wait(2)
    
    -- Создаём GUI
    CreateGUI()
    
    -- Выбираем всех игроков
    SelectAllPlayers()
    
    -- Если флинг был активен до перехода — запускаем
    if getgenv().FlingData.Active then
        wait(1)
        StartFling()
    end
    
    -- Запускаем таймер
    StartTimer()
    
    -- Уведомление
    Message("🔥 АВТО-ФЛИНГ", "Скрипт активен! Убиваю всех!", 5)
    
    print("[✅] Скрипт успешно запущен!")
end

-- ============================================
-- ✅ ЗАПУСК
-- ============================================

-- Настраиваем авто-перезапуск
SetupAutoRejoin()

-- Запускаем основной скрипт
AutoStart()
