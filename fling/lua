        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= Player then
                SelectedTargets[player.Name] = player
            end
        end
        SaveState()
        UpdateStatus()
        UpdatePlayerList()
        Message("Цели выбраны", "Выбрано " .. #Players:GetPlayers() - 1 .. " игроков", 2)
    end

    function DeselectAllPlayers()
        SelectedTargets = {}
        SaveState()
        UpdateStatus()
        UpdatePlayerList()
        Message("Отменено", "Все цели отменены", 2)
    end

    -- ========== ТАЙМЕР ==========
    function StartRejoinTimer()
        if RejoinTimer then
            RejoinTimer:Disconnect()
            RejoinTimer = nil
        end

        local timeLeft = 600

        RejoinTimer = RunService.Heartbeat:Connect(function(dt)
            if AutoRejoinActive then
                timeLeft = timeLeft - dt
                if timeLeft <= 0 then
                    JoinOtherServer()
                    RejoinTimer:Disconnect()
                    return
                end
                if math.floor(timeLeft) % 5 == 0 then
                    UpdateRejoinInfo(timeLeft)
                end
            end
        end)
    end

